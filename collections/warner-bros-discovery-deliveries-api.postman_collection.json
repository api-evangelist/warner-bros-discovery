  "info": {
    "_postman_id": "fb9e255a-fa29-491f-8d4a-31db8d8572b0",
    "name": "Warner Bros. Discovery Content Partner Assets Deliveries API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Warner Bros. Discovery Content Partner API enables content partners to deliver media assets and metadata to WBD's media supply chain. The API supports Automated Content Delivery (ACD) for high-volume media ingest using the MovieLabs Media Manifest Core (MMC) specification, metadata validation, and delivery status tracking. Partners use this API to submit content for distribution across Max, HBO, Warner Bros., Discovery, CNN, and other WBD brands.\n\nContact Support:\n Name: Warner Bros. Discovery Content Partner Support",
      "type": "text/plain"
    }
  }
